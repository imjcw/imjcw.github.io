<section class="page-header">
  <div class="page-header-inner">
    <span class="badge">标签 / #<%= page.name || '' %></span>
    <h1 class="page-header-title">#<%= page.name || '标签' %></h1>
    <p class="page-header-desc"><%= page.description || '' %></p>
  </div>
</section>

<main class="main">
  <div class="main-inner">
    <div class="tag-cloud">
      <% site.tags.each(function(tag) { %>
        <a href="<%- url_for(tag.path) %>"
           class="tag-cloud-item <%= tag.name === page.name ? 'active' : '' %>">
          <span>#<%= tag.name %></span>
        </a>
      <% }); %>
    </div>

    <div class="card-grid" style="margin-top:48px;">
      <% page.posts.each(function(post) { %>
        <article class="card">
          <div class="card-body">
            <% if (post.categories.length > 0) { %>
              <span class="card-tag"><%- post.categories.first().name %></span>
            <% } %>
            <h3 class="card-title">
              <a href="<%- url_for(post.path) %>"><%= post.title %></a>
            </h3>
            <p class="card-excerpt">
              <% var excerpt = post.excerpt ? strip_html(post.excerpt) : strip_html(post.content) %>
              <%- excerpt.substr(0, 80) %><% if (excerpt.length > 80) { %>...<% } %>
            </p>
            <div class="card-meta">
              <span><%- date(post.date, config.date_format) %></span>
              <span>·</span>
              <span><%= Math.ceil(post.content.length / 400) %> 分钟</span>
            </div>
            <% if (post.tags.length > 0) { %>
              <div class="card-tags">
                <% post.tags.each(function(tag) { %>
                  <a href="<%- url_for(tag.path) %>" class="tag-pill">#<%= tag.name %></a>
                <% }); %>
              </div>
            <% } %>
          </div>
        </article>
      <% }); %>
    </div>

    <% if (page.total > page.per_page) { %>
      <div class="pagination-wrap">
        <%- paginator({
          prev_text: '← 上一页',
          next_text: '下一页 →',
          mid_surround: 2
        }) %>
      </div>
    <% } %>
  </div>
</main>
<!DOCTYPE html>
<html lang="<%= config.language || 'zh-CN' %>">
<%- partial('_partial/head.ejs') %>
<body>
  <div class="deco-star ds1" style="top:8%;left:6%;">✦</div>
  <div class="deco-star ds2" style="top:18%;left:90%;">✧</div>
  <div class="deco-star ds3" style="top:40%;left:4%;">✦</div>
  <div class="deco-star ds4" style="top:60%;left:94%;">✦</div>
  <div class="deco-star ds5" style="top:82%;left:10%;">✧</div>
  <div class="deco-star ds6" style="top:50%;left:48%;">✦</div>

  <script>
    (function () {
      var stars = document.querySelectorAll('.deco-star');
      if (!stars.length) return;
      var w = innerWidth, h = innerHeight;
      var COLOR_SETS = [
        [26, 26, 26],
        [26, 26, 26],
        [26, 26, 26],
        [239, 68, 68],
        [59, 130, 246],
        [250, 204, 21]
      ];

      function rand(min, max) {
        return Math.random() * (max - min) + min;
      }

      function relocateOne() {
        var idx = Math.floor(Math.random() * stars.length);
        var star = stars[idx];
        star.style.transition = 'opacity 2s ease-in-out';
        star.style.opacity = '0';
        setTimeout(function () {
          star.style.transition = 'none';
          star.style.left = rand(3, w - 40) + 'px';
          star.style.top = rand(3, h - 40) + 'px';
          star.style.fontSize = rand(14, 22) + 'px';
          var rot = rand(-45, 45);
          var b = rand(0.18, 0.35);
          var c = COLOR_SETS[Math.floor(Math.random() * COLOR_SETS.length)];
          star.style.transform = 'rotate(' + rot + 'deg)';
          star.style.color = 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',' + b + ')';
          star.style.opacity = '0';
          requestAnimationFrame(function () {
            star.style.transition = 'opacity 3s ease-in-out';
            star.style.opacity = '1';
          });
        }, 2500);
      }

      setInterval(relocateOne, 5000);
    })();
  </script>

  <%- partial('_partial/nav.ejs') %>
  <%- body %>
  <%- partial('_partial/footer.ejs') %>
</body>
</html>
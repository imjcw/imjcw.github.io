<!DOCTYPE html>
<html lang="<%= config.language || 'zh-CN' %>">
<%- partial('_partial/head.ejs') %>
<body>
  <div class="comic-loader" id="comic-loader" role="status" aria-live="polite">
    <style>
      .comic-loader{position:fixed;inset:0;z-index:9999;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;background:#fffef0;transition:opacity .35s ease,visibility .35s}
      .comic-loader.is-hidden{opacity:0;visibility:hidden;pointer-events:none}
      .comic-loader-badge{position:relative;width:84px;height:84px;border:4px solid #1a1a1a;border-radius:18px;background:#facc15;box-shadow:6px 6px 0 #1a1a1a;display:flex;align-items:center;justify-content:center;animation:comic-wobble 1.4s ease-in-out infinite}
      @keyframes comic-wobble{0%,100%{transform:rotate(-4deg)}50%{transform:rotate(4deg)}}
      .comic-loader-ring{position:absolute;inset:9px;border:3px solid #1a1a1a;border-radius:11px;background:#fffef0}
      .comic-loader-dot{width:22px;height:22px;background:#ef4444;border:3px solid #1a1a1a;border-radius:50%;box-shadow:3px 3px 0 #1a1a1a;animation:comic-dot 1s ease-in-out infinite}
      @keyframes comic-dot{0%,100%{transform:scale(1)}50%{transform:scale(1.3)}}
      .comic-loader-text{font-size:15px;font-weight:900;color:#1a1a1a;letter-spacing:.12em;animation:comic-blink 1.2s steps(2,end) infinite}
      @keyframes comic-blink{50%{opacity:.35}}
      @media(prefers-reduced-motion:reduce){.comic-loader-badge,.comic-loader-dot,.comic-loader-text{animation:none}}
    </style>
    <div class="comic-loader-badge" aria-hidden="true">
      <div class="comic-loader-ring"></div>
      <div class="comic-loader-dot"></div>
    </div>
    <div class="comic-loader-text">加载中…</div>
  </div>
  <script>
    (function () {
      var loader = document.getElementById('comic-loader');
      function hideLoader() {
        if (!loader || loader.classList.contains('is-hidden')) return;
        loader.classList.add('is-hidden');
        setTimeout(function () { if (loader && loader.parentNode) loader.parentNode.removeChild(loader); }, 400);
      }
      if (document.readyState === 'complete') hideLoader();
      else { window.addEventListener('load', hideLoader); setTimeout(hideLoader, 4000); }
    })();
  </script>

  <div class="deco-star ds1" style="top:8%;left:6%;">✦</div>
  <div class="deco-star ds2" style="top:18%;left:90%;">✧</div>
  <div class="deco-star ds3" style="top:40%;left:4%;">✦</div>
  <div class="deco-star ds4" style="top:60%;left:94%;">✦</div>
  <div class="deco-star ds5" style="top:82%;left:10%;">✧</div>
  <div class="deco-star ds6" style="top:50%;left:48%;">✦</div>

  <script>
    (function () {
      var stars = document.querySelectorAll('.deco-star');
      if (!stars.length) return;
      var w = innerWidth, h = innerHeight;
      var COLOR_SETS = [
        [26, 26, 26],
        [26, 26, 26],
        [26, 26, 26],
        [239, 68, 68],
        [59, 130, 246],
        [250, 204, 21]
      ];

      function rand(min, max) {
        return Math.random() * (max - min) + min;
      }

      function relocateOne() {
        var idx = Math.floor(Math.random() * stars.length);
        var star = stars[idx];
        star.style.transition = 'opacity 2s ease-in-out';
        star.style.opacity = '0';
        setTimeout(function () {
          star.style.transition = 'none';
          star.style.left = rand(3, w - 40) + 'px';
          star.style.top = rand(3, h - 40) + 'px';
          star.style.fontSize = rand(14, 22) + 'px';
          var rot = rand(-45, 45);
          var b = rand(0.18, 0.35);
          var c = COLOR_SETS[Math.floor(Math.random() * COLOR_SETS.length)];
          star.style.transform = 'rotate(' + rot + 'deg)';
          star.style.color = 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',' + b + ')';
          star.style.opacity = '0';
          requestAnimationFrame(function () {
            star.style.transition = 'opacity 3s ease-in-out';
            star.style.opacity = '1';
          });
        }, 2500);
      }

      setInterval(relocateOne, 5000);
    })();
  </script>

  <script>
    (function () {
      var imgs = document.querySelectorAll('img:not(.img-loaded)');
      imgs.forEach(function (img) {
        if (img.complete) {
          img.classList.add('img-loaded');
        } else {
          img.addEventListener('load', function () {
            img.classList.add('img-loaded');
          });
          img.addEventListener('error', function () {
            img.classList.add('img-loaded');
          });
        }
      });
    })();
  </script>

  <%- partial('_partial/nav.ejs') %>
  <%- body %>
  <%- partial('_partial/footer.ejs') %>
</body>
</html>
<!DOCTYPE html>
<html lang="<%= config.language || 'zh-CN' %>">
<%- partial('_partial/head.ejs') %>
<body>
  <div class="page-stars">
    <span class="deco-star d1">✦</span>
    <span class="deco-star d2">✧</span>
    <span class="deco-star d3">✦</span>
    <span class="deco-star d4">✧</span>
    <span class="deco-star d5">✦</span>
    <span class="deco-star d6">✧</span>
    <span class="deco-star d7">✦</span>
    <span class="deco-star d8">✧</span>
    <span class="deco-star d9">✦</span>
    <span class="deco-star d10">✧</span>
    <span class="deco-star d11">✦</span>
    <span class="deco-star d12">✧</span>
  </div>
  <script>
    (function () {
      var stars = document.querySelectorAll('.deco-star');
      if (!stars.length) return;
      var w = innerWidth, h = innerHeight;

      function rand(min, max) {
        return Math.random() * (max - min) + min;
      }

      function place(star, immediate) {
        var size = rand(14, 24);
        var x = rand(2, w - 20);
        var y = rand(2, h - 20);
        var brightness = rand(0.35, 0.75);
        var rot = rand(-45, 45);
        star.style.left = x + 'px';
        star.style.top = y + 'px';
        star.style.fontSize = size + 'px';
        star.style.transform = 'rotate(' + rot + 'deg)';
        star.style.color = 'rgba(26,26,26,' + brightness + ')';
        if (immediate) {
          star.style.opacity = '1';
        } else {
          star.style.opacity = '0';
        }
      }

      // Initial placement — all visible
      stars.forEach(function (s) { place(s, true); });

      // Slowly fade out one star, then fade in at random position
      function relocateOne() {
        var idx = Math.floor(Math.random() * stars.length);
        var star = stars[idx];
        star.classList.add('visible');
        star.style.opacity = '0';
        setTimeout(function () {
          place(star, true);
        }, 2500);
      }

      setInterval(relocateOne, 4000);
    })();
  </script>
  <%- partial('_partial/nav.ejs') %>
  <%- body %>
  <%- partial('_partial/footer.ejs') %>
</body>
</html>
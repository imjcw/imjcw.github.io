<%
  // Generic page layout (about, links, etc.)
%>
<main class="py-14 px-6 md:px-8 lg:px-12">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-3xl md:text-5xl font-black uppercase tracking-tight leading-tight">
      <%= page.title %>
    </h1>
    <% if (page.date) { %>
    <div class="mt-4 flex items-center gap-3 text-sm font-bold text-[#1a1a1a]/70">
      <span><%- date(page.date, config.date_format) %></span>
    </div>
    <% } %>
    <article class="mt-12 space-y-6 leading-relaxed text-[#1a1a1a]/85 font-bold text-base">
      <%- page.content %>
    </article>
  </div>
</main>
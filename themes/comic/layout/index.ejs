<%
  var hero = theme.hero || {};
  var index = theme.index || {};
%>

<% if (hero.enable !== false) { %>
<section class="hero">
  <div class="hero-inner">
    <div>
      <% if (hero.badge) { %>
        <span class="badge"><%= hero.badge %></span>
      <% } %>
      <h1 class="hero-title"><%= hero.title || config.title %></h1>
      <p class="hero-desc"><%= hero.description || config.description || '' %></p>
      <% if (hero.buttons && hero.buttons.length > 0) { %>
        <div class="hero-buttons">
          <% hero.buttons.forEach(function(btn) { %>
            <a href="<%- url_for(btn.url) %>" class="btn btn-red"><%= btn.text %></a>
          <% }); %>
        </div>
      <% } %>
    </div>
    <div class="hero-bubble-wrap">
      <div class="hero-bubble">
        <p class="hero-bubble-text">
          "<%= hero.quote || config.subtitle || '每一页都是分镜，每一格都是一次冒险。' %>"
        </p>
      </div>
    </div>
  </div>
</section>
<% } %>

<div class="section-head">
  <h2 class="section-title"><%= index.section_title || '新连载!' %></h2>
  <% if (index.full_catalog_url) { %>
    <a href="<%- url_for(index.full_catalog_url) %>" class="btn btn-cream">完整目录</a>
  <% } %>
</div>

<main class="main">
  <div class="main-inner">
    <div class="card-grid">
      <% page.posts.each(function(post) { %>
        <article class="card">
          <div class="card-body">
            <% if (post.categories.length > 0 && index.show_category !== false) { %>
              <span class="card-tag"><%- post.categories.first().name %></span>
            <% } %>
            <h3 class="card-title">
              <a href="<%- url_for(post.path) %>"><%= post.title %></a>
            </h3>
            <p class="card-excerpt">
              <% var excerpt = '' %>
              <% if (post.excerpt) { %>
                <% excerpt = strip_html(post.excerpt).substr(0, 100) %>
              <% } else { %>
                <% excerpt = strip_html(post.content).substr(0, 100) %>
              <% } %>
              <%- excerpt %><% if (excerpt.length >= 100) { %>...<% } %>
            </p>
            <div class="card-meta">
              <span><%- date(post.date, config.date_format) %></span>
              <span>·</span>
              <span><%= post.content ? Math.ceil(post.content.length / 400) : 5 %> 分钟</span>
            </div>
            <% if (post.tags.length > 0 && index.show_tags !== false) { %>
              <div class="card-tags">
                <% post.tags.each(function(tag) { %>
                  <a href="<%- url_for(tag.path) %>" class="tag-pill">#<%= tag.name %></a>
                <% }); %>
              </div>
            <% } %>
          </div>
        </article>
      <% }); %>
    </div>

    <% if (page.total > page.per_page) { %>
      <div class="pagination-wrap">
        <%- paginator({
          prev_text: '← 上一页',
          next_text: '下一页 →',
          mid_surround: 2
        }) %>
      </div>
    <% } %>
  </div>
</main>
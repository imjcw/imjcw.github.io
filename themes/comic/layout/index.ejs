<%
  var hero = theme.hero || {};
  var index = theme.index || {};
%>

<% if (hero.enable !== false) { %>
<section class="hero hero-center">
  <div class="hero-inner hero-inner-center">
    <div>
      <% if (hero.badge) { %>
        <span class="badge"><%= hero.badge %></span>
      <% } %>
      <% if (hero.title) { %>
        <h1 class="hero-title"><%= hero.title %></h1>
      <% } %>
      <% if (hero.description || config.description) { %>
        <p class="hero-desc"><%= hero.description || config.description %></p>
      <% } %>
      <% if (hero.buttons && hero.buttons.length > 0) { %>
        <div class="hero-buttons">
          <% hero.buttons.forEach(function(btn) { %>
            <a href="<%- url_for(btn.url) %>" class="btn btn-red"><%= btn.text %></a>
          <% }); %>
        </div>
      <% } %>
    </div>
  </div>
</section>
<% } %>

<main class="main">
  <div class="main-inner">
    <div class="post-list">
      <% page.posts.each(function(post) { %>
        <article class="post-list-item">
          <div class="post-list-left">
            <div class="post-list-date">
              <span class="post-list-day"><%= post.date.date().toString().padStart(2, '0') %></span>
              <span class="post-list-year"><%= post.date.year() %></span>
            </div>
            <% if (post.categories.length > 0 && index.show_category !== false) { %>
              <span class="card-tag"><%- post.categories.first().name %></span>
            <% } %>
          </div>
          <div class="post-list-right">
            <h3 class="card-title">
              <a href="<%- url_for(post.path) %>"><%= post.title %></a>
            </h3>
            <p class="card-excerpt">
              <% var excerpt = '' %>
              <% if (post.excerpt) { %>
                <% excerpt = strip_html(post.excerpt).substr(0, 120) %>
              <% } else { %>
                <% excerpt = strip_html(post.content).substr(0, 120) %>
              <% } %>
              <%- excerpt %><% if (excerpt.length >= 120) { %>...<% } %>
            </p>
            <div class="card-meta">
              <span><%= post.content ? Math.ceil(post.content.length / 400) : 5 %> 分钟</span>
              <% if (post.tags.length > 0 && index.show_tags !== false) { %>
                <span class="post-list-tags">
                  <% post.tags.each(function(tag) { %>
                    <a href="<%- url_for(tag.path) %>" class="tag-pill">#<%= tag.name %></a>
                  <% }); %>
                </span>
              <% } %>
            </div>
          </div>
        </article>
      <% }); %>
    </div>

    <% var hasNext = false; %>
<% if (typeof config.index_generator !== 'undefined' && config.index_generator && config.index_generator.per_page) { %>
  <% var pp = config.index_generator.per_page; %>
<% } else if (config.per_page) { %>
  <% var pp = config.per_page; %>
<% } else { %>
  <% var pp = 10; %>
<% } %>
<% if (page.posts && page.posts.length >= pp) { hasNext = true; } %>

<% if (hasNext || (page.current && page.current > 1)) { %>
      <div class="pagination-wrap">
        <%- paginator({
          prev_text: '← 上一页',
          next_text: '下一页 →',
          mid_surround: 2
        }) %>
      </div>
    <% } %>
  </div>
</main>
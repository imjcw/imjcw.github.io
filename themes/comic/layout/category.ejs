<section class="page-header">
  <div class="page-header-inner">
    <% var cn = '' %>
    <% var pp = page.path || '' %>
    <% var ppTrimmed = pp.replace(/\/index\.html$/, '').replace(/\/$/, '') %>
    <% site.categories.each(function(c) {
        var cp = c.path.replace(/\/$/, '')
        if (cp === ppTrimmed) { cn = c.name }
    }); %>
    <span class="badge">分类 / <%= cn || page.title || page.category || '' %></span>
    <h1 class="page-header-title"><%= cn || page.title || page.category || '分类' %></h1>
    <p class="page-header-desc"><%= page.description || '' %></p>
  </div>
</section>

<main class="main">
  <div class="main-inner">
    <div class="category-cloud">
      <% site.categories.sort(function(a, b) { return b.posts.length - a.posts.length; }).each(function(cate) { %>
        <a href="<%- url_for(cate.path) %>" class="category-cloud-item">
          <span><%= cate.name %></span>
          <span class="category-cloud-count"><%= cate.posts.length %></span>
        </a>
      <% }); %>
    </div>

    <div class="post-list" style="margin-top:48px;">
      <% page.posts.each(function(post) { %>
          <article class="post-list-item">
            <div class="post-list-left">
              <div class="post-list-date">
                <span class="post-list-day"><%= post.date.date().toString().padStart(2, '0') %></span>
                <span class="post-list-year"><%= post.date.year() %></span>
              </div>
              <% if (post.categories.length > 0) { %>
                <span class="card-tag"><%= post.categories.first().name %></span>
              <% } %>
            </div>
            <div class="post-list-right">
              <h3 class="card-title">
                <a href="<%- url_for(post.path) %>"><%= post.title %></a>
              </h3>
              <p class="card-excerpt">
                <% var excerpt = '' %>
                <% if (post.excerpt) { %>
                  <% excerpt = strip_html(post.excerpt).substr(0, 120) %>
                <% } else { %>
                  <% excerpt = strip_html(post.content).substr(0, 120) %>
                <% } %>
                <%- excerpt %><% if (excerpt.length >= 120) { %>...<% } %>
              </p>
              <div class="card-meta">
                <%
                  var _content = post.content || '';
                  // 阅读时间：正文按 300 字/分钟；代码块(<pre>)与 mermaid 图表块(<div class="mermaid-svg">)按固定时间(每块 1 分钟)。
                  // 这样可避免 SVG 内的 <style> 文本 / 代码字符被当成正文字数，导致阅读时间虚高。
                  var _codeBlocks = (_content.match(/<pre[\s\S]*?<\/pre>/gi) || []).length;
                  var _mermaidBlocks = (_content.match(/<div[^>]*class="[^"]*mermaid-svg[^"]*"[\s\S]*?<\/div>/gi) || []).length;
                  var _clean = _content
                    .replace(/<pre[\s\S]*?<\/pre>/gi, '')
                    .replace(/<div[^>]*class="[^"]*mermaid-svg[^"]*"[\s\S]*?<\/div>/gi, '');
                  var _chars = _clean ? strip_html(_clean).replace(/\s/g, '').length : 0;
                  var _readingMinutes = _content ? Math.ceil(_chars / 300) + _codeBlocks + _mermaidBlocks : 5;
                %>
                <span><%= _readingMinutes %> 分钟</span>
                <% if (post.tags.length > 0) { %>
                  <span class="post-list-tags">
                    <% post.tags.each(function(tag) { %>
                      <a href="<%- url_for(tag.path) %>" class="tag-pill">#<%= tag.name %></a>
                    <% }); %>
                  </span>
                <% } %>
              </div>
            </div>
          </article>
        <% }); %>
    </div>

    <% if (page.total > 1) { %>
      <div class="pagination-wrap">
        <%- paginator({
          prev_text: '← 上一页',
          next_text: '下一页 →',
          mid_surround: 2
        }) %>
      </div>
    <% } %>
  </div>
</main>
<section class="page-header">
  <div class="page-header-inner">
    <span class="badge">分类 / <%= page.name || '' %></span>
    <h1 class="page-header-title"><%= page.name || '分类' %></h1>
    <p class="page-header-desc"><%= page.description || '' %></p>
  </div>
</section>

<main class="main">
  <div class="main-inner">
    <div class="layout-grid">
      <div class="card-grid-2">
        <% page.posts.each(function(post) { %>
          <article class="card">
            <div class="card-body">
              <span class="card-tag"><%= page.name %></span>
              <h3 class="card-title">
                <a href="<%- url_for(post.path) %>"><%= post.title %></a>
              </h3>
              <p class="card-excerpt">
                <% var excerpt = post.excerpt ? strip_html(post.excerpt) : strip_html(post.content) %>
                <%- excerpt.substr(0, 80) %><% if (excerpt.length > 80) { %>...<% } %>
              </p>
              <div class="card-meta">
                <span><%- date(post.date, config.date_format) %></span>
                <span>·</span>
                <span><%= Math.ceil(post.content.length / 400) %> 分钟</span>
              </div>
              <% if (post.tags.length > 0) { %>
                <div class="card-tags">
                  <% post.tags.each(function(tag) { %>
                    <a href="<%- url_for(tag.path) %>" class="tag-pill">#<%= tag.name %></a>
                  <% }); %>
                </div>
              <% } %>
            </div>
          </article>
        <% }); %>
      </div>

      <aside>
        <div class="sidebar">
          <h3 class="sidebar-title">全部分类</h3>
          <% site.categories.each(function(cate) { %>
            <a href="<%- url_for(cate.path) %>" class="sidebar-item">
              <span><%= cate.name %></span>
              <span class="count"><%= cate.posts.length %></span>
            </a>
          <% }); %>
        </div>
      </aside>
    </div>
  </div>
</main>
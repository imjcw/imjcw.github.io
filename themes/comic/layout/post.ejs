<%
  var meta = theme.post_meta || {};
%>
<main class="post-page">
  <button class="post-toc-toggle" id="tocToggleBtn" title="目录">☰</button>
  <% if (page.categories.length > 0) { %>
    <div class="post-category-tags">
      <% page.categories.each(function(cate) { %>
        <span class="card-tag"><%= cate.name %></span>
      <% }); %>
    </div>
  <% } %>

  <h1 class="post-title"><%= page.title %></h1>

  <div class="post-meta">
    <% if (meta.show_author !== false) { %>
      <span>作者：<%= page.author || config.author %></span>
    <% } %>
    <% if (meta.show_date !== false) { %>
      <span>·</span>
      <span><%- date(page.date, config.date_format) %></span>
    <% } %>
  </div>

  <% if (page.tags.length > 0) { %>
    <div class="post-tags">
      <% page.tags.each(function(tag) { %>
        <a href="<%- url_for(tag.path) %>" class="tag-pill">#<%= tag.name %></a>
      <% }); %>
    </div>
  <% } %>

  <article class="post-content">
    <%- page.content %>
  </article>

  <%
    var rawMd = page._content || '';
    var fmMatch = rawMd.match(/^---[\s\S]*?---\s*\n/);
    if (fmMatch) rawMd = rawMd.substring(fmMatch[0].length);
  %>
  <div class="post-raw-wrap">
    <button class="post-raw-toggle" id="rawToggleBtn">查看 Markdown 源码</button>
    <div class="post-raw-content" id="rawContent">
      <div class="post-raw-header">
        <span class="post-raw-title">Markdown 源码</span>
        <button class="post-raw-copy" id="rawCopyBtn" title="复制源码">复制</button>
      </div>
      <pre class="post-raw-code"><%= rawMd %></pre>
    </div>
  </div>

  <div class="post-disclaimer">
    <div class="post-disclaimer-text">本文章观点仅代表个人立场，部分观点可能已过时，仅供参考。</div>
    <div class="post-disclaimer-cc">本博客所有文章除特别声明外，均采用 <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener" class="cc-link">CC BY-SA 4.0</a> 协议，转载请注明出处！</div>
  </div>

  <% if (page.prev || page.next) { %>
    <div class="post-nav">
      <% if (page.prev) { %>
        <a href="<%- url_for(page.prev.path) %>" class="post-nav-card">
          <div class="post-nav-label">← 上一篇</div>
          <div class="post-nav-title"><%= page.prev.title %></div>
        </a>
      <% } %>
      <% if (page.next) { %>
        <a href="<%- url_for(page.next.path) %>" class="post-nav-card post-nav-next">
          <div class="post-nav-label">下一篇 →</div>
          <div class="post-nav-title"><%= page.next.title %></div>
        </a>
      <% } %>
    </div>
  <% } %>

  <% if (page.content && (page.content.indexOf('<div class="mermaid-svg"') > -1)) { %>
    <script src="<%- url_for('/js/render-mermaid.js') %>"></script>
  <% } %>

  <script>
    (function () {
      var article = document.querySelector('.post-content');
      if (!article) return;

      // Add real copy button element
      article.querySelectorAll('figure.highlight').forEach(function (fig) {
        var btn = document.createElement('span');
        btn.className = 'code-copy-btn';
        btn.setAttribute('title', '复制代码');
        fig.appendChild(btn);
      });

      article.addEventListener('click', function (e) {
        var btn = e.target.closest ? e.target.closest('.code-copy-btn') : null;
        if (btn) {
          var fig = btn.parentElement;
          var pre = fig.querySelector('pre');
          if (pre) {
            navigator.clipboard.writeText(pre.innerText || pre.textContent).then(function () {
              var old = fig.querySelector('.code-copy-bubble');
              if (old) old.remove();
              var bubble = document.createElement('span');
              bubble.className = 'code-copy-bubble';
              bubble.textContent = '已复制';
              fig.appendChild(bubble);
              requestAnimationFrame(function () { bubble.classList.add('show'); });
              setTimeout(function () {
                bubble.classList.remove('show');
                setTimeout(function () { bubble.remove(); }, 200);
              }, 1200);
            }).catch(function () {});
          }
          return;
        }

        // Image lightbox
        var img = e.target.closest ? e.target.closest('img') : null;
        if (img && img.classList.contains('post-img-clickable')) {
          e.preventDefault();
          imgPreview.open(img);
        }
      });

      // Make images clickable + add caption from alt + loading animation
      article.querySelectorAll('img').forEach(function (img) {
        img.classList.add('post-img-clickable');
        img.style.cursor = 'pointer';
        if (img.complete) {
          img.classList.add('img-loaded');
        } else {
          img.addEventListener('load', function () {
            img.classList.add('img-loaded');
          });
          img.addEventListener('error', function () {
            img.classList.add('img-loaded');
          });
        }
        if (img.alt) {
          var cap = document.createElement('div');
          cap.className = 'post-img-caption';
          cap.textContent = img.alt;
          img.parentNode.insertBefore(cap, img.nextSibling);
        }
      });
    })();
  </script>

  <script>
    var imgPreview = (function () {
      var overlay = null;
      var box = null;
      var imgEl = null;
      var closeBtn = null;
      var zoomInBtn = null, zoomOutBtn = null, resetBtn = null, zoomLabel = null;

      var scale = 1;
      var panX = 0, panY = 0;
      var isPanning = false;
      var panStartX = 0, panStartY = 0;
      var initialized = false;

      function build() {
        overlay = document.createElement('div');
        overlay.className = 'img-preview-overlay';
        overlay.setAttribute('role', 'dialog');
        overlay.setAttribute('tabindex', '-1');

        box = document.createElement('div');
        box.className = 'img-preview-box';

        imgEl = document.createElement('img');
        imgEl.className = 'img-preview-img';
        imgEl.draggable = false;
        box.appendChild(imgEl);

        // Zoom controls
        var controls = document.createElement('div');
        controls.className = 'img-preview-controls';

        zoomOutBtn = document.createElement('span');
        zoomOutBtn.className = 'img-preview-zoom-out';
        zoomOutBtn.title = '缩小';
        zoomOutBtn.innerHTML = '<svg viewBox="0 0 24 24" width="20" height="20"><path d="M6 12 H18" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>';
        zoomOutBtn.addEventListener('click', function () { applyZoom(-0.2, innerWidth / 2, innerHeight / 2); });

        zoomLabel = document.createElement('span');
        zoomLabel.className = 'img-preview-zoom-label';
        zoomLabel.textContent = '100%';

        zoomInBtn = document.createElement('span');
        zoomInBtn.className = 'img-preview-zoom-in';
        zoomInBtn.title = '放大';
        zoomInBtn.innerHTML = '<svg viewBox="0 0 24 24" width="20" height="20"><path d="M12 6 V18 M6 12 H18" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>';
        zoomInBtn.addEventListener('click', function () { applyZoom(0.2, innerWidth / 2, innerHeight / 2); });

        resetBtn = document.createElement('span');
        resetBtn.className = 'img-preview-reset';
        resetBtn.title = '重置';
        resetBtn.innerHTML = '<svg viewBox="0 0 24 24" width="20" height="20"><path d="M4 12a8 8 0 1 1 2 5.7" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round"/><polyline points="4,4 4,10 10,10" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>';
        resetBtn.addEventListener('click', reset);

        controls.appendChild(zoomOutBtn);
        controls.appendChild(zoomLabel);
        controls.appendChild(zoomInBtn);
        controls.appendChild(resetBtn);
        overlay.appendChild(controls);

        closeBtn = document.createElement('span');
        closeBtn.className = 'img-preview-close';
        closeBtn.innerHTML = '<svg viewBox="0 0 24 24" width="24" height="24"><path d="M6 6 L18 18 M18 6 L6 18" stroke="currentColor" stroke-width="3" fill="none" stroke-linecap="round"/></svg>';
        overlay.appendChild(closeBtn);

        overlay.appendChild(box);
        document.body.appendChild(overlay);

        closeBtn.addEventListener('click', close);
        overlay.addEventListener('click', function (e) {
          if (e.target === overlay) close();
        });

        overlay.addEventListener('wheel', function (e) {
          e.preventDefault();
          var delta = -e.deltaY * 0.001;
          if (Math.abs(delta) < 0.01) return;
          applyZoom(delta * 3, e.clientX, e.clientY);
        }, { passive: false });

        overlay.addEventListener('mousedown', function (e) {
          if (e.target.closest('.img-preview-controls')) return;
          if (e.target.classList.contains('img-preview-close')) return;
          isPanning = true;
          panStartX = e.clientX - panX;
          panStartY = e.clientY - panY;
          applyTransform();
        });

        document.addEventListener('mousemove', function (e) {
          if (!isPanning) return;
          panX = e.clientX - panStartX;
          panY = e.clientY - panStartY;
          applyTransform();
        });

        document.addEventListener('mouseup', function () {
          if (isPanning) {
            isPanning = false;
            applyTransform();
          }
        });

        document.addEventListener('keydown', function (e) {
          if (!overlay || !overlay.classList.contains('visible')) return;
          if (e.key === 'Escape') { close(); return; }
          if (e.key === '+' || e.key === '=') { applyZoom(0.2, innerWidth / 2, innerHeight / 2); }
          if (e.key === '-') { applyZoom(-0.2, innerWidth / 2, innerHeight / 2); }
          if (e.key === '0') { reset(); }
        });

        initialized = true;
      }

      function applyZoom(delta, cx, cy) {
        var newScale = Math.max(0.1, Math.min(10, scale + delta));
        if (newScale === scale) return;
        var oldScale = scale;
        scale = newScale;
        var factor = scale / oldScale;
        var cxRel = cx - innerWidth / 2;
        var cyRel = cy - innerHeight / 2;
        panX = cxRel * (1 - factor) + factor * panX;
        panY = cyRel * (1 - factor) + factor * panY;
        applyTransform();
      }

      function applyTransform() {
        if (!imgEl) return;
        imgEl.style.transform = 'scale(' + scale + ') translate(' + (panX / scale) + 'px, ' + (panY / scale) + 'px)';
        imgEl.style.transformOrigin = 'center center';
        zoomLabel.textContent = Math.round(scale * 100) + '%';
        imgEl.style.cursor = isPanning ? 'grabbing' : 'grab';
        box.style.cursor = isPanning ? 'grabbing' : 'grab';
      }

      function reset() {
        scale = 1;
        panX = 0;
        panY = 0;
        applyTransform();
      }

      function open(srcImg) {
        if (!overlay) build();
        imgEl.src = srcImg.src;
        imgEl.alt = srcImg.alt || '';
        scale = 1;
        panX = 0;
        panY = 0;
        applyTransform();
        overlay.classList.add('visible');
        document.body.style.overflow = 'hidden';
      }

      function close() {
        if (!overlay) return;
        overlay.classList.remove('visible');
        document.body.style.overflow = '';
      }

      return { open: open };
    })();
  </script>

  <script>
    (function () {
      var btn = document.getElementById('rawToggleBtn');
      var content = document.getElementById('rawContent');
      var copyBtn = document.getElementById('rawCopyBtn');
      var code = document.querySelector('.post-raw-code');
      if (!btn || !content) return;

      btn.addEventListener('click', function () {
        content.classList.toggle('visible');
        btn.classList.toggle('active');
        btn.textContent = content.classList.contains('visible') ? '收起 Markdown 源码' : '查看 Markdown 源码';
      });

      if (copyBtn && code) {
        copyBtn.addEventListener('click', function () {
          navigator.clipboard.writeText(code.textContent).then(function () {
            var old = content.querySelector('.post-raw-copy-bubble');
            if (old) old.remove();
            var bubble = document.createElement('span');
            bubble.className = 'post-raw-copy-bubble';
            bubble.textContent = '已复制';
            copyBtn.parentNode.insertBefore(bubble, copyBtn);
            requestAnimationFrame(function () { bubble.classList.add('show'); });
            setTimeout(function () {
              bubble.classList.remove('show');
              setTimeout(function () { bubble.remove(); }, 200);
            }, 1200);
          }).catch(function () {});
        });
      }
    })();
  </script>
<style>
/* ========== TOC (Table of Contents) ========== */
.post-toc-toggle {
  position: fixed;
  top: 20px;
  right: 20px;
  z-index: 998;
  display: none;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  padding: 0;
  background: #fffef0;
  border: 2px solid #1a1a1a;
  border-radius: 6px;
  box-shadow: 2px 2px 0 0 #1a1a1a;
  color: #1a1a1a;
  cursor: pointer;
  font-family: inherit;
  font-size: 16px;
  font-weight: 900;
  line-height: 1;
  transition: all 0.15s;
}
.post-toc-toggle:hover {
  transform: translate(1px, 1px);
  box-shadow: 1px 1px 0 0 #1a1a1a;
  background: #facc15;
}
@media (max-width: 1200px) {
  .post-toc-toggle { display: flex; }
}

.post-toc-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 999;
}
.post-toc-overlay.active { display: block; }

/* Desktop: minimal tree — flush to right edge */
.post-toc {
  position: fixed;
  top: 80px;
  right: 20px;
  width: 260px;
  max-height: calc(100vh - 160px);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans SC", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 13px;
  color: #333;
}
@media (max-width: 1200px) {
  .post-toc { display: none; }
}
@media (min-width: 1201px) {
  .post-toc { display: flex; }
}

.post-toc-header {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 16px;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1;
  padding: 4px 0;
}
.post-toc-header-title {
  flex: 0 0 auto;
}
.post-toc-header-actions {
  display: flex;
  gap: 6px;
  margin-left: 4px;
  color: #666;
  font-size: 14px;
  line-height: 1;
}
.post-toc-header-actions span {
  cursor: pointer;
  padding: 2px;
  user-select: none;
}
.post-toc-header-actions span:hover { color: #333; }
.post-toc-close-btn { display: none; }

.post-toc-list {
  position: relative;
  padding: 12px 0 0 0;
  margin: 0;
  list-style: none;
  overflow-y: auto;
  max-height: calc(100vh - 200px);
}

.post-toc-item {
  display: block;
  padding: 2px 0;
  font-size: 13px;
  font-weight: 400;
  color: #666;
  text-decoration: none;
  line-height: 1.8;
  cursor: pointer;
  transition: color 0.15s;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.post-toc-item:hover { color: #333; }
.post-toc-item.active {
  color: #1a1a1a;
  font-weight: 700;
}
/* Arrow: ▼ when expanded, ▸ when collapsed */
.post-toc-item .toc-arrow {
  display: inline-block;
  width: 10px;
  font-size: 9px;
  color: #999;
  user-select: none;
  transition: transform 0.15s;
  margin-right: 4px;
  vertical-align: middle;
}
.post-toc-item .toc-arrow.empty { display: none; }
.post-toc-item.expanded > .toc-arrow {
  transform: rotate(90deg);
}
.post-toc-item .toc-text {
  display: inline;
}

/* Children: indented, no rail */
.post-toc-children {
  display: block;
  padding-left: 24px;
  list-style: none;
  margin: 0;
  position: relative;
}
/* Active section: short rail bar on left */
.post-toc-children.active-section {
  padding-left: 24px;
}
.post-toc-children.active-section::before {
  content: '';
  position: absolute;
  left: 14px;
  top: 6px;
  bottom: 6px;
  width: 1px;
  background: #ccc;
}
.post-toc-children.collapsed { display: none; }

/* Mobile: bottom drawer */
@media (max-width: 1200px) {
  .post-toc {
    display: flex;
    position: fixed;
    left: 0;
    right: 0;
    top: auto;
    bottom: 0;
    width: 100%;
    max-height: 50vh;
    border-top: 2px solid #1a1a1a;
    border-radius: 12px 12px 0 0;
    box-shadow: 0 -2px 12px rgba(0,0,0,0.15);
    transform: translateY(100%);
    transition: transform 0.3s ease;
    background: #fffef0;
    padding: 0;
  }
  .post-toc.active {
    transform: translateY(0);
  }
  .post-toc-header {
    padding: 14px 18px 12px;
    font-size: 15px;
    border-bottom: 1px solid #e0e0e0;
  }
  .post-toc-list {
    padding: 8px 18px;
    max-height: calc(50vh - 80px);
  }
  .post-toc-list::before { left: 8px; }
  .post-toc-item {
    font-size: 14px;
    padding: 6px 4px 6px 24px;
  }
  .post-toc-item .toc-arrow { left: 4px; }
  .post-toc-children { padding-left: 24px; }
  .post-toc-children::before { left: 6px; }
  .post-toc-close-btn {
    background: none;
    border: none;
    font-size: 18px;
    cursor: pointer;
    padding: 2px 6px;
    color: #666;
    line-height: 1;
  }
}
</style>

  <div class="post-toc-overlay" id="tocOverlay"></div>
  <aside class="post-toc" id="tocDrawer">
    <div class="post-toc-header">
      <span class="post-toc-header-title">大纲</span>
      <span class="post-toc-header-actions">
        <span id="tocCollapseAll" title="收起全部">⊘</span>
        <span id="tocExpandAll" title="展开全部">☰</span>
      </span>
      <button class="toc-close-btn" id="tocCloseBtn">✕</button>
    </div>
    <nav class="post-toc-list" id="tocList"></nav>
  </aside>

  <script>
    (function () {
      var article = document.querySelector('.post-content');
      if (!article) return;

      var headings = article.querySelectorAll('h1, h2, h3, h4');
      if (headings.length === 0) return;

      var tocList = document.getElementById('tocList');
      var toggleBtn = document.getElementById('tocToggleBtn');
      var drawer = document.getElementById('tocDrawer');
      var overlay = document.getElementById('tocOverlay');
      var closeBtn = document.getElementById('tocCloseBtn');

      // Ensure headings have IDs
      headings.forEach(function (h, i) {
        if (!h.id) h.id = 'toc-heading-' + i;
      });

      // Build tree: group children under their parent
      var flatItems = [];
      headings.forEach(function (h) {
        flatItems.push({
          level: parseInt(h.tagName.charAt(1)),
          id: h.id,
          text: h.textContent.trim(),
          el: h
        });
      });

      // Build nested tree
      var tree = [];
      var stack = [];
      flatItems.forEach(function (item) {
        while (stack.length > 0 && stack[stack.length - 1].level >= item.level) {
          stack.pop();
        }
        if (stack.length > 0) {
          stack[stack.length - 1].children = stack[stack.length - 1].children || [];
          stack[stack.length - 1].children.push(item);
        } else {
          tree.push(item);
        }
        stack.push(item);
      });

      function buildTOCNode(item, depth) {
        var hasChildren = item.children && item.children.length > 0;
        var container = document.createElement('div');
        var a = document.createElement('a');
        var childrenWrap = null;

        a.className = 'post-toc-item depth-' + (depth + 1);
        a.href = '#' + item.id;

        var arrow = document.createElement('span');
        arrow.className = 'toc-arrow' + (hasChildren ? '' : ' empty');
        arrow.textContent = '▸';

        var text = document.createElement('span');
        text.className = 'toc-text';
        text.textContent = item.text;

        a.appendChild(arrow);
        a.appendChild(text);
        container.appendChild(a);

        a.addEventListener('click', function (e) {
          e.preventDefault();
          item.el.scrollIntoView({ behavior: 'smooth', block: 'start' });
          if (hasChildren && childrenWrap) {
            childrenWrap.classList.contains('collapsed')
              ? childrenWrap.classList.remove('collapsed')
              : childrenWrap.classList.add('collapsed');
            childrenWrap.classList.contains('collapsed')
              ? a.classList.remove('expanded')
              : a.classList.add('expanded');
          }
        });

        if (hasChildren) {
          childrenWrap = document.createElement('div');
          childrenWrap.className = 'post-toc-children';
          item.children.forEach(function (child) {
            childrenWrap.appendChild(buildTOCNode(child, depth + 1));
          });
          container.appendChild(childrenWrap);
        }

        return container;
      }

      tree.forEach(function (node) {
        tocList.appendChild(buildTOCNode(node, 0));
      });

      // Expand / collapse all
      var expandAllBtn = document.getElementById('tocExpandAll');
      var collapseAllBtn = document.getElementById('tocCollapseAll');
      if (expandAllBtn) {
        expandAllBtn.addEventListener('click', function () {
          tocList.querySelectorAll('.post-toc-children').forEach(function (c) {
            c.classList.remove('collapsed');
          });
          tocList.querySelectorAll('.post-toc-item').forEach(function (item) {
            if (item.querySelector('.toc-arrow:not(.empty)')) {
              item.classList.add('expanded');
            }
          });
        });
      }
      if (collapseAllBtn) {
        collapseAllBtn.addEventListener('click', function () {
          tocList.querySelectorAll('.post-toc-children').forEach(function (c) {
            c.classList.add('collapsed');
          });
          tocList.querySelectorAll('.post-toc-item').forEach(function (item) {
            item.classList.remove('expanded');
          });
        });
      }

      // Toggle (mobile)
      function openToc() {
        drawer.classList.add('active');
        overlay.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
      function closeToc() {
        drawer.classList.remove('active');
        overlay.classList.remove('active');
        document.body.style.overflow = '';
      }
      if (toggleBtn) toggleBtn.addEventListener('click', function () {
        drawer.classList.contains('active') ? closeToc() : openToc();
      });
      if (closeBtn) closeBtn.addEventListener('click', closeToc);
      if (overlay) overlay.addEventListener('click', closeToc);

      // Scroll spy
      var tocItems = tocList.querySelectorAll('.post-toc-item');

      function updateActive() {
        var scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        var activeIdx = -1;
        for (var i = 0; i < headings.length; i++) {
          if (headings[i].getBoundingClientRect().top < 60) {
            activeIdx = i;
          }
        }
        tocItems.forEach(function (item, i) {
          if (i === activeIdx) {
            item.classList.add('active');
          } else {
            item.classList.remove('active');
          }
        });
        // Expand ancestors of active item and mark active section
        tocItems.forEach(function (item) {
          if (item.classList.contains('active')) {
            var parentWrap = item.parentElement;
            while (parentWrap) {
              if (parentWrap.classList.contains('post-toc-children')) {
                parentWrap.classList.add('active-section');
                parentWrap.classList.remove('collapsed');
                var parentItem = parentWrap.previousElementSibling;
                if (parentItem && parentItem.classList.contains('post-toc-item')) {
                  parentItem.classList.add('expanded');
                }
              }
              parentWrap = parentWrap.parentElement;
            }
          }
        });
      }

      var ticking = false;
      window.addEventListener('scroll', function () {
        if (!ticking) {
          requestAnimationFrame(function () { updateActive(); ticking = false; });
          ticking = true;
        }
      });
      updateActive();
    })();
  </script>
</main>
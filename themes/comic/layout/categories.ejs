<section class="page-header">
  <div class="page-header-inner">
    <span class="badge">CATEGORIES</span>
    <h1 class="page-header-title">全十分类</h1>
    <p class="page-header-desc"><%= theme.categories.description || '按分类浏览所有文章' %></p>
  </div>
</section>

<main class="main">
  <div class="cat-grid">
    <% site.categories.each(function(cate) { %>
      <a href="<%- url_for(cate.path) %>" class="cat-card">
        <div class="cat-card-head">
          <h3 class="cat-card-title"><%= cate.name %></h3>
          <span class="cat-card-count"><%= cate.posts.length %></span>
        </div>
        <% if (cate.posts.length > 0) { %>
          <% var latest = cate.posts.first(); %>
          <p class="cat-card-latest">
            最新：<%= latest.title.length > 20 ? latest.title.substr(0, 20) + '...' : latest.title %>
          </p>
        <% } %>
      </a>
    <% }); %>
  </div>
</main>
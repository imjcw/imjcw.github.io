<section class="page-header">
  <div class="page-header-inner">
    <span class="badge">CATEGORIES</span>
    <h1 class="page-header-title">所有分类</h1>
    <p class="page-header-desc"><%= theme.categories.description || '按分类浏览所有文章' %></p>
  </div>
</section>

<main class="main">
  <div class="tag-cloud">
    <% site.categories.sort(function(a, b) { return b.posts.length - a.posts.length; }).each(function(cate) { %>
      <a href="<%- url_for(cate.path) %>" class="tag-cloud-item">
        <span><%= cate.name %></span>
        <span class="tag-cloud-count"><%= cate.posts.length %></span>
      </a>
    <% }); %>
  </div>
</main>
<section class="page-header">
  <div class="page-header-inner">
    <span class="badge">TAGS</span>
    <h1 class="page-header-title">所有标签</h1>
    <p class="page-header-desc"><%= theme.tags.description || '按标签浏览所有文章' %></p>
  </div>
</section>

<main class="main">
  <div class="tag-cloud">
    <% site.tags.sort(function(a, b) { return b.posts.length - a.posts.length; }).each(function(tag) { %>
      <a href="<%- url_for(tag.path) %>" class="tag-cloud-item">
        <span>#<%= tag.name %></span>
        <span class="tag-cloud-count"><%= tag.posts.length %></span>
      </a>
    <% }); %>
  </div>
</main>
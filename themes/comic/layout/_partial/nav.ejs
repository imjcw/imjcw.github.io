<nav class="border-b-4 border-[#1a1a1a] px-4 md:px-8 lg:px-12 py-4 bg-[#fffef0]">
  <div class="max-w-6xl mx-auto flex items-center justify-between">
    <a href="<%- url_for('/') %>" class="text-3xl md:text-5xl font-black uppercase tracking-tight leading-tight">
      <%= config.title %>
    </a>
    <div class="flex items-center gap-6 text-sm font-black uppercase tracking-wide">
      <% for (var key in theme.menu) { %>
        <% var activeClass = (page.path === theme.menu[key] || (theme.menu[key] === '/' && page.path === 'index.html')) ? 'font-black underline underline-offset-4' : 'hover:scale-110 hover:-rotate-3 transition-transform duration-150' %>
        <a href="<%- url_for(theme.menu[key]) %>" class="<%= activeClass %>"><%= key %></a>
      <% } %>
    </div>
  </div>
</nav>
<nav class="nav">
  <div class="nav-inner">
    <a href="<%- url_for('/') %>" class="nav-title">
      <%= config.title %>
    </a>
    <div class="nav-links">
      <% for (var key in theme.menu) { %>
        <% var isActive = (page.path === theme.menu[key]) || (theme.menu[key] === '/' && (page.path === 'index.html' || page.path === '')) %>
        <a href="<%- url_for(theme.menu[key]) %>" class="<%= isActive ? 'active' : '' %>"><%= key %></a>
      <% } %>
    </div>
  </div>
</nav>
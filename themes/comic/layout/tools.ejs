<section class="page-header">
  <div class="page-header-inner">
    <span class="badge">TOOLS</span>
    <h1 class="page-header-title">工具箱</h1>
    <p class="page-header-desc"><%= page.description || '日常小工具集合，让开发效率翻倍' %></p>
  </div>
</section>

<main class="main">
  <div class="tool-grid">
    <% var tools = page.tools || []; tools.forEach(function (tool) { %>
      <a href="<%- url_for(tool.link || '#') %>" class="tool-card">
        <div class="tool-card-body">
          <h3 class="tool-card-title"><%= tool.name %></h3>
          <p class="tool-card-desc"><%= tool.desc %></p>
          <% if (tool.tags && tool.tags.length) { %>
            <div class="tool-card-tags">
              <% tool.tags.forEach(function (tag) { %>
                <span class="tool-tag"><%= tag %></span>
              <% }); %>
            </div>
          <% } %>
        </div>
        <span class="tool-card-arrow">&rarr;</span>
      </a>
    <% }); %>
  </div>
</main>
